<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
    <com.identvia.android.SignInWithIdentviaButton android:id="@+id/signIn" android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:identviaTheme="dark" app:identviaText="continueWith" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <Button android:id="@+id/userinfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call userinfo" android:visibility="gone" />
    <Button android:id="@+id/signOut" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign out" android:visibility="gone" />
</LinearLayout>
